# ═══════════════════════════════════════════════════════════════
#  Código del Futuro — Variables de entorno
#
#  EN PRODUCCIÓN (Netlify): Site configuration → Environment variables
#  EN LOCAL: copia este archivo como ".env" y rellena tus valores.
#
#  Credenciales en: https://www.mercadopago.com.co/developers/panel/credentials
#  Para probar usa las credenciales TEST-*; para vender de verdad, las de
#  PRODUCCIÓN (Access Token que empieza por APP_USR-).
# ═══════════════════════════════════════════════════════════════

# Access Token PRIVADO de MercadoPago (solo backend, nunca en el frontend)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# ── Solo para `npm start` en tu computador ─────────────────────
PORT=3000
